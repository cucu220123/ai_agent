# Real API -> optional real local weights. No silent Mock fallback.
LLM_PROVIDER=auto
STRICT_REAL_LLM=1
AI_FACTORY_TRACE=1

# Keep the actual credential file outside the repository.
# AI_FACTORY_SECRET_FILE=/path/outside/repo/secret.txt
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=your-model
# LLM_TIMEOUT_SECONDS=600

# Optional dedicated code/repair API. See README for loopback model servers.
# OPENAI_CODER_BASE_URL=http://127.0.0.1:18087/v1
# OPENAI_CODER_MODEL=Qwen3-Coder-30B-A3B-Instruct
# OPENAI_CODER_API_KEY=replace-me

# Direct local inference is optional; choose a GPU with sufficient free memory.
# LLM_PROVIDER=local
# LOCAL_INSTRUCTION_MODEL_PATH=/path/to/instruction-model
# LOCAL_CODER_MODEL_PATH=/path/to/code-model
# LOCAL_LLM_DEVICE=cuda:0
# LOCAL_LLM_LOAD_IN_4BIT=1
# EMBEDDING_MODEL_PATH=/path/to/embedding-model
# EMBEDDING_DEVICE=cpu
# ENABLE_LOCAL_EMBEDDING=0

# Deterministic CI must be explicitly selected: LLM_PROVIDER=mock
# CODEGEN_MODE=free_form_llm
# BEAM_WIDTH=3
# MAX_REPAIR_ROUNDS=3
# VALIDATION_TIMEOUT_SECONDS=90
# VALIDATION_MEMORY_MB=16384
# AI_FACTORY_WORKSPACE=/path/to/isolated/workspace
# Linux resource limits are applied by the isolated worker automatically.
