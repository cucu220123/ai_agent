# Default: cloud API -> local model -> Mock fallback
LLM_PROVIDER=auto

# Optional OpenAI-compatible mode
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=your-model

# Optional local Transformers mode
# LLM_PROVIDER=local
# LOCAL_INSTRUCTION_MODEL_PATH=/data/public_checkpoints/huggingface_models/Qwen2.5-14B-Instruct
# LOCAL_CODER_MODEL_PATH=/data/public_checkpoints/huggingface_models/Qwen2.5-Coder-3B-Instruct
# LOCAL_LLM_DEVICE=cuda:0
# EMBEDDING_MODEL_PATH=/data/public_checkpoints/huggingface_models/shibing624-text2vec-base-chinese
# EMBEDDING_DEVICE=cpu
# SANDBOX_ENABLE_RLIMITS=0  # enable only in a dedicated worker process/container
