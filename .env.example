# Default: cloud API -> local model -> Mock fallback
LLM_PROVIDER=auto

# Optional OpenAI-compatible mode
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=your-model

# Optional local Transformers mode
# LLM_PROVIDER=local
# LOCAL_MODEL_PATH=/data/public_checkpoints/huggingface_models/Qwen2.5-1.5B-Instruct
